# Copie ce fichier en « .env » pour lancer le jeu en local.
# Sur Render, mets ces deux variables dans Environment (jamais dans le dépôt).

# Projet Supabase (Project Settings → Data API → Project URL).
SUPABASE_URL=https://huvqzodfncksbirxnkfq.supabase.co

# Project Settings → API keys → clé « service_role » (secrète).
# Sans elle, le jeu démarre quand même : tout le monde joue en invité.
SUPABASE_SERVICE_ROLE_KEY=

# Render fournit PORT ; en local, vide = 3000 (public/js/config.js).
PORT=
